from turtle import Turtle,Turtle, Turtle, Turtle, Turtle, Turtle, Screen
import random
is_race_on = False
new_turtle = Turtle()
screen = Screen()
screen.setup(width= 500, height= 400)
color = ["red", "orange", "yellow", "green", "blue", "purple"]
y_position = [-70, -40 , -10, 20, 50, 80]
user_bet = screen.textinput(title= "Make a bet!", prompt= "which turtle will win the race? enter a color:")
turtle_list = []
for index in range(0, 6):
    new_turtle = Turtle(shape= "turtle")
    new_turtle.penup()
    new_turtle.color(color[index])
    new_turtle.goto(x= -230, y= y_position[index])
    turtle_list.append(new_turtle)
if user_bet:
    is_race_on = True
while is_race_on:
    for turtle in turtle_list:
        if turtle.xcor() > 230:
            is_race_on = False
            winning_color = turtle.pencolor()
            if winning_color == user_bet:
                print(f"you won! the winning turtle is turtle{winning_color}")
            else:
                print(f"you lost! the winning turtle is turtle{winning_color}")

        rand_distance = random.randint(0, 10)
        turtle.forward(rand_distance)


screen.exitonclick()
